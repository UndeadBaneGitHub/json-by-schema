{
  "name": "json-by-schema",
  "version": "0.3.0",
  "description": "A React UI component to view and edit JSON or YAML configurations driven by a JSON Schema",
  "author": "UndeadBaneGitHub <u9262450174@gmail.com>",
  "license": "MIT",
  "homepage": "https://undeadbanegithub.github.io/json-by-schema/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UndeadBaneGitHub/json-by-schema.git"
  },
  "bugs": {
    "url": "https://github.com/UndeadBaneGitHub/json-by-schema/issues"
  },
  "type": "module",
  "main": "./dist/json-by-schema.cjs",
  "module": "./dist/json-by-schema.js",
  "types": "./src/index.d.ts",
  "style": "./dist/json-by-schema.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/json-by-schema.js",
      "require": "./dist/json-by-schema.cjs"
    },
    "./styles.css": "./dist/json-by-schema.css",
    "./dist/json-by-schema.css": "./dist/json-by-schema.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "JSONSchema",
    "JSON",
    "YAML",
    "React",
    "Redux",
    "Vite",
    "SchemaEditor",
    "ConfigEditor"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "biome lint src demo e2e",
    "format": "biome format --write src demo e2e",
    "check": "biome check --write src demo e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.12",
    "immutable": "^5.2.1",
    "jsonschema": "^1.4.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-highlight-words": "^1.0.0",
    "react-intl": "^6.6.8",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-saga": "^1.3.0",
    "reselect": "^4.1.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
