  "license": "MIT",
  "type": "module",
  "main": "./dist/json-by-schema.cjs",
  "module": "./dist/json-by-schema.js",
  "exports": {
    ".": {
      "import": "./dist/json-by-schema.js",
      "require": "./dist/json-by-schema.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
