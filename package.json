    "ace-builds": "^1.36.2",
    "hoist-non-react-statics": "^3.3.2",
    "immutable": "^4.3.7",
    "invariant": "^2.2.4",
    "jsonschema": "^1.4.1",
    "lodash.conformsto": "^4.15.0",
    "lodash.isempty": "^4.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-ace": "^12.0.0",
